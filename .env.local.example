# ============================================================================
# MessCost — Firebase Client Configuration
# ============================================================================
# Copy this file to `.env.local` and fill in the values from your Firebase
# Console (Project Settings -> General -> Your apps -> Web app).
#
# NOTE ON SECURITY:
# Firebase client keys (NEXT_PUBLIC_FIREBASE_*) are safe to expose in frontend
# browser bundles because they only identify your Firebase project.
# Actual data security MUST be enforced via `firestore.rules` and `storage.rules`.
# Never commit `.env.local` to Git.
# ============================================================================

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: Firebase App Check reCAPTCHA v3 Site Key (Free Tier)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Optional: Firebase Analytics Measurement ID (Leave blank if not needed)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
